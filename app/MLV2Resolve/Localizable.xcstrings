    "Analyzing the clip's motion and matching it with the gyro log.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzing the clip's motion and matching it with the gyro log."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse du mouvement du plan et recherche de sa place dans le log gyro."
          }
        }
      }
    },
    "Synced (R² %@)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synced (R² %@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisé (R² %@)"
          }
        }
      }
    },
    "Synced with %@, offset %@ ms. R² tells how well the clip's motion matches the gyro (1 = perfect). In Resolve: Gyroflow plugin → Load for current file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synced with %1$@, offset %2$@ ms. R² tells how well the clip's motion matches the gyro (1 = perfect). In Resolve: Gyroflow plugin → Load for current file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisé avec %1$@, décalage %2$@ ms. Le R² indique à quel point le mouvement du plan correspond au gyro (1 = parfait). Dans Resolve : plugin Gyroflow → Load for current file."
          }
        }
      }
    },
    "Existing .gyroflow": {
      "extractionState": "manual",
