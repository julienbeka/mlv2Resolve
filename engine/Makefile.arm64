# Build MLVFS for Apple Silicon against FUSE-T. Run from engine/ (see scripts/build-engine.sh).
CC = clang
ARCH = -arch arm64
GIT_VERSION := $(shell git describe --long --dirty --always --tags 2>/dev/null || echo unknown)

SRC = mlvfs
FUSE_INC ?= /usr/local/include/fuse
FUSE_LIB ?= /usr/local/lib

CFLAGS = $(ARCH) -O2 -Wall -Wno-deprecated-declarations -Wno-unused-function -Wno-unused-variable \
  -D_FILE_OFFSET_BITS=64 -DFUSE_USE_VERSION=26 -DVERSION="\"$(GIT_VERSION)\"" \
  -std=gnu99 -I$(FUSE_INC) -I$(SRC)
LIBS = -L$(FUSE_LIB) -lfuse-t -lz -pthread -Wl,-rpath,$(FUSE_LIB)

LZMA_SRCS = 7zAlloc 7zBuf 7zBuf2 7zCrc 7zCrcOpt 7zDec 7zFile 7zIn 7zStream Alloc Bcj2 Bra Bra86 BraIA64 CpuArch Delta LzFind Lzma2Dec Lzma2Enc Lzma86Dec Lzma86Enc LzmaDec LzmaEnc LzmaLib Ppmd7 Ppmd7Dec Ppmd7Enc Sha256 Xz XzCrc64
OBJS = $(addprefix $(SRC)/, dng.o index.o wav.o stripes.o cs.o amaze_demosaic_RT.o hdr.o histogram.o \
  mongoose/mongoose.o webgui.o resource_manager.o lj92.o gif.o patternnoise.o focus_pixels.o slre/slre.o) \
  $(addprefix $(SRC)/LZMA/, $(addsuffix .o, $(LZMA_SRCS)))

HDRS = $(wildcard $(SRC)/*.h)
TEST_BIN = ../build/engine/lj92_truncation_test

default: mlvfs-bin

.PHONY: default clean lj92-test

mlvfs-bin: $(SRC)/main.c $(OBJS) $(HDRS)
	$(CC) $(CFLAGS) $(SRC)/main.c $(OBJS) $(LIBS) -o mlvfs-bin

# coarse header dependency: any header change rebuilds every object (no stale binaries)
$(SRC)/%.o: $(SRC)/%.c $(HDRS)
	$(CC) -c $(CFLAGS) $< -o $@

# LJ92 truncation regression test (no FUSE needed): make -f Makefile.arm64 lj92-test
lj92-test: $(TEST_BIN)

$(TEST_BIN): tests/lj92_truncation_test.c $(SRC)/lj92.c $(SRC)/lj92.h
	mkdir -p $(dir $@)
	$(CC) $(ARCH) -O1 -g -Wall -std=gnu99 -fsanitize=undefined -I$(SRC) tests/lj92_truncation_test.c $(SRC)/lj92.c -o $@

clean:
	rm -f mlvfs-bin $(OBJS) $(TEST_BIN)
