# Build MLVFS for Apple Silicon against FUSE-T. Run from engine/ (see scripts/build-engine.sh).
CC = clang
ARCH = -arch arm64
GIT_VERSION := $(shell git describe --long --dirty --always --tags 2>/dev/null || echo unknown)

SRC = mlvfs
FUSE_INC ?= /usr/local/include/fuse
FUSE_LIB ?= /usr/local/lib

CFLAGS = $(ARCH) -O2 -Wall -Wno-deprecated-declarations -Wno-unused-function -Wno-unused-variable \
  -D_FILE_OFFSET_BITS=64 -DFUSE_USE_VERSION=26 -DVERSION="\"$(GIT_VERSION)\"" \
  -std=gnu99 -I$(FUSE_INC) -I$(SRC)
LIBS = -L$(FUSE_LIB) -lfuse-t -lz -pthread -Wl,-rpath,$(FUSE_LIB)

LZMA_SRCS = 7zAlloc 7zBuf 7zBuf2 7zCrc 7zCrcOpt 7zDec 7zFile 7zIn 7zStream Alloc Bcj2 Bra Bra86 BraIA64 CpuArch Delta LzFind Lzma2Dec Lzma2Enc Lzma86Dec Lzma86Enc LzmaDec LzmaEnc LzmaLib Ppmd7 Ppmd7Dec Ppmd7Enc Sha256 Xz XzCrc64
OBJS = $(addprefix $(SRC)/, dng.o index.o wav.o stripes.o cs.o amaze_demosaic_RT.o hdr.o histogram.o \
  resource_manager.o lj92.o gif.o patternnoise.o focus_pixels.o dual_iso_switch.o resolve_name.o sidecar.o) \
  $(addprefix $(SRC)/LZMA/, $(addsuffix .o, $(LZMA_SRCS)))

HDRS = $(wildcard $(SRC)/*.h)
TEST_BIN = ../build/engine/lj92_truncation_test
RESOLVE_TEST_BIN = ../build/engine/resolve_name_test
CACHE_TEST_BIN = ../build/engine/dual_iso_cache_test
SIDECAR_TEST_BIN = ../build/engine/sidecar_test

default: mlvfs-bin

.PHONY: default clean lj92-test resolve-name-test sidecar-test dual-iso-cache-test dual-iso-cache-test-asan

mlvfs-bin: $(SRC)/main.c $(OBJS) $(HDRS)
	$(CC) $(CFLAGS) $(SRC)/main.c $(OBJS) $(LIBS) -o mlvfs-bin

# coarse header dependency: any header change rebuilds every object (no stale binaries)
$(SRC)/%.o: $(SRC)/%.c $(HDRS)
	$(CC) -c $(CFLAGS) $< -o $@

# LJ92 truncation regression test (no FUSE needed): make -f Makefile.arm64 lj92-test
lj92-test: $(TEST_BIN)

$(TEST_BIN): tests/lj92_truncation_test.c $(SRC)/lj92.c $(SRC)/lj92.h
	mkdir -p $(dir $@)
	$(CC) $(ARCH) -O1 -g -Wall -std=gnu99 -fsanitize=undefined -I$(SRC) tests/lj92_truncation_test.c $(SRC)/lj92.c -o $@

# Resolve-naming folder match test (no FUSE needed): make -f Makefile.arm64 resolve-name-test
resolve-name-test: $(RESOLVE_TEST_BIN)
	$(RESOLVE_TEST_BIN)

$(RESOLVE_TEST_BIN): tests/resolve_name_test.c $(SRC)/resolve_name.c $(SRC)/resolve_name.h
	mkdir -p $(dir $@)
	$(CC) $(ARCH) -O1 -g -Wall -std=gnu99 -fsanitize=undefined -I$(SRC) tests/resolve_name_test.c $(SRC)/resolve_name.c -o $@

# Sidecar name rules + index test (no FUSE needed): make -f Makefile.arm64 sidecar-test
sidecar-test: $(SIDECAR_TEST_BIN)
	$(SIDECAR_TEST_BIN)

$(SIDECAR_TEST_BIN): tests/sidecar_test.c $(SRC)/sidecar.c $(SRC)/sidecar.h
	mkdir -p $(dir $@)
	$(CC) $(ARCH) -O1 -g -Wall -std=gnu99 -fsanitize=undefined -I$(SRC) tests/sidecar_test.c $(SRC)/sidecar.c -pthread -o $@

# Live dual ISO switch (signals) + image buffer cache generation test: make -f Makefile.arm64 dual-iso-cache-test
# Runs the UBSan build, then the same binary under Guard Malloc (freed memory unmapped: a use-after-free
# crashes). Every run is bounded by a 60 s alarm.
TIMEOUT = perl -e 'alarm 60; exec @ARGV'
CACHE_TEST_SRCS = tests/dual_iso_cache_test.c $(SRC)/resource_manager.c $(SRC)/dual_iso_switch.c
CACHE_TEST_ASAN_BIN = ../build/engine/dual_iso_cache_test_asan

dual-iso-cache-test: $(CACHE_TEST_BIN)
	$(TIMEOUT) $(CACHE_TEST_BIN)
	$(TIMEOUT) env DYLD_INSERT_LIBRARIES=/usr/lib/libgmalloc.dylib $(CACHE_TEST_BIN) 2>/dev/null

$(CACHE_TEST_BIN): $(CACHE_TEST_SRCS) $(HDRS)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -O1 -g -fsanitize=undefined $(CACHE_TEST_SRCS) -pthread -o $@

# Same test under AddressSanitizer (60 s alarm: on macOS 26 / Xcode 17 the ASan runtime can hang at startup).
dual-iso-cache-test-asan: $(CACHE_TEST_ASAN_BIN)
	$(TIMEOUT) $(CACHE_TEST_ASAN_BIN)

$(CACHE_TEST_ASAN_BIN): $(CACHE_TEST_SRCS) $(HDRS)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -O1 -g -fsanitize=address,undefined $(CACHE_TEST_SRCS) -pthread -o $@

clean:
	rm -f mlvfs-bin $(OBJS) $(TEST_BIN) $(RESOLVE_TEST_BIN) $(SIDECAR_TEST_BIN) $(CACHE_TEST_BIN) $(CACHE_TEST_ASAN_BIN)
